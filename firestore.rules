rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Super Admin UID
    function getSuperAdminUid() {
      return "OMmHouAdfuVnLa1RPak0MgN7KdX2";
    }

    // Check if the requesting user is the Super Admin
    function isSuperAdmin() {
      return request.auth != null && request.auth.uid == getSuperAdminUid();
    }

    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the requesting user is the owner of the document
    function isOwner(data) {
      return isAuthenticated() && request.auth.uid == data.userId;
    }

    // Check if requesting user is an active waiter or kitchen staff of the restaurant
    function isStaff(restaurantId) {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'waiter' || 
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'kitchen') &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.restaurantId == restaurantId;
    }

    // 1. Users Collection (Restaurant Owners, Staff & Super Admin)
    // Public read so customer menu can display restaurant name/logo and resolve business slug
    match /users/{userId} {
      allow read: if true;
      allow write: if (isAuthenticated() && request.auth.uid == userId) || isSuperAdmin();
    }

    // 2. Menu Items, Categories, Schedules (Public read for customers & Telegram Mini App)
    match /menuItems/{menuItemId} {
      allow read: if true;
      allow write: if isOwner(request.resource.data) || isOwner(resource.data) || isSuperAdmin();
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isOwner(request.resource.data) || isOwner(resource.data) || isSuperAdmin();
    }
    match /menuSchedules/{scheduleId} {
      allow read: if true;
      allow write: if isOwner(request.resource.data) || isOwner(resource.data) || isSuperAdmin();
    }

    // 3. Internal Restaurant Management Collections
    match /departments/{departmentId} {
      allow write: if isOwner(request.resource.data) || isOwner(resource.data) || isSuperAdmin();
      allow read: if isOwner(resource.data) || isSuperAdmin() || isStaff(resource.data.userId);
    }
    match /waiterAssignments/{assignmentId} {
      allow write: if isOwner(request.resource.data) || isOwner(resource.data) || isSuperAdmin();
      allow read: if isOwner(resource.data) || isSuperAdmin() || isStaff(resource.data.userId);
    }
    match /dayReports/{reportId} {
      allow write: if isOwner(request.resource.data) || isOwner(resource.data) || isSuperAdmin();
      allow read: if isOwner(resource.data) || isSuperAdmin();
    }
    match /deliveryIntegrations/{integrationId} {
      allow write: if isOwner(request.resource.data) || isOwner(resource.data) || isSuperAdmin();
      allow read: if isOwner(resource.data) || isSuperAdmin();
    }
    match /bills/{billId} {
      allow write: if isOwner(request.resource.data) || isOwner(resource.data) || isSuperAdmin();
      allow read: if isOwner(resource.data) || isSuperAdmin();
    }

    // 4. Customer Interactions (Guests can create orders, calls, payments)
    match /orders/{orderId} {
      allow create: if true;
      allow update, delete: if isOwner(resource.data) || isSuperAdmin() || isStaff(resource.data.userId);
      allow read: if true;
    }
    match /pendingOrders/{pendingOrderId} {
      allow create: if true;
      allow update, delete: if isOwner(resource.data) || isSuperAdmin();
      allow read: if isOwner(resource.data) || isSuperAdmin();
    }
    match /paymentConfirmations/{confirmationId} {
      allow create: if true;
      allow update, delete: if isOwner(resource.data) || isSuperAdmin();
      allow read: if true;
    }
    match /waiterCalls/{callId} {
      allow create: if true;
      allow update, delete: if isOwner(resource.data) || isSuperAdmin() || isStaff(resource.data.userId);
      allow read: if true;
    }
    match /tableBills/{billId} {
      allow create, update: if true;
      allow delete: if isOwner(resource.data) || isSuperAdmin();
      allow read: if true;
    }

    // 5. Notifications
    match /notificationTemplates/{templateId} {
      allow write: if isOwner(request.resource.data) || isOwner(resource.data) || isSuperAdmin();
      allow read: if isOwner(resource.data) || isSuperAdmin();
    }
    match /scheduledNotifications/{notificationId} {
      allow write: if isOwner(request.resource.data) || isOwner(resource.data) || isSuperAdmin();
      allow read: if isOwner(resource.data) || isSuperAdmin();
    }
    match /customerNotificationPreferences/{preferencesId} {
      allow create, update, read: if true;
    }
    match /notificationDeliveries/{deliveryId} {
      allow read: if isOwner(resource.data) || isSuperAdmin();
    }
    match /notificationSettings/{settingsId} {
      allow write: if isOwner(request.resource.data) || isOwner(resource.data) || isSuperAdmin();
      allow read: if isOwner(resource.data) || isSuperAdmin();
    }
    match /liveNotifications/{notificationId} {
      allow read: if true;
    }

    // 6. Webhooks & Logs
    match /deliveryWebhookEvents/{eventId} {
      allow read: if isOwner(resource.data) || isSuperAdmin();
    }
    match /bulkPriceUpdates/{updateId} {
      allow read: if isOwner(resource.data) || isSuperAdmin();
    }
    match /orderStatusUpdates/{updateId} {
      allow read: if isOwner(resource.data) || isSuperAdmin();
    }
    match /itemAvailabilityUpdates/{updateId} {
      allow read: if isOwner(resource.data) || isSuperAdmin();
    }
    match /pushTokens/{tokenId} {
      allow create, update: if true;
      allow read: if true;
    }

    // Fallback deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}